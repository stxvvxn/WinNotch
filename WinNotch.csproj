<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WinNotch</AssemblyName>
    <RootNamespace>WinNotch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>notch.ico</ApplicationIcon>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep Windows Forms names (Button, Color...) out of the way of the WPF ones -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="notch.ico" LogicalName="WinNotch.notch.ico" />
    <!-- Shown on the About tab in Settings -->
    <EmbeddedResource Include="FEATURES.txt" LogicalName="WinNotch.FEATURES.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Searching the whole PC through the Windows Search index -->
    <PackageReference Include="System.Data.OleDb" Version="9.0.0" />
  </ItemGroup>

</Project>
