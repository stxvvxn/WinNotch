<Window x:Class="WinNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch Settings"
        Width="1100" Height="600"
        MinWidth="700" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C" Foreground="White"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#333333" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Each page scrolls on its own -->
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Padding" Value="16,0,16,16"/>
        </Style>

        <!-- Sidebar tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="8,2" Height="34">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" Background="#FF9F0A"
                                    HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <ContentPresenter ContentSource="Header" Margin="12,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262626"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E2E2E"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#171717">
                                <StackPanel IsItemsHost="True" Margin="0,10,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">

            <!-- ============ General ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="General"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="STARTUP" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Click="Changed"/>
                                <CheckBox x:Name="HideInFullscreenBox" Content="Auto-hide on full screen apps, games and videos" Click="Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="UPDATES" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,4"/>
                                    <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically" Click="Changed"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="GitHub repo" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="UpdateRepoBox" Style="{StaticResource Field}" Width="220" HorizontalAlignment="Right"
                                             LostFocus="Changed" KeyDown="Field_KeyDown" ToolTip="owner/repo"/>
                                </DockPanel>
                                <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="APPEARANCE" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Notch size" VerticalAlignment="Center"/>
                                <ComboBox x:Name="SizeBox" Grid.Column="1" Margin="0,5" SelectionChanged="Changed">
                                    <ComboBoxItem Content="Small" Tag="small"/>
                                    <ComboBoxItem Content="Normal" Tag="normal"/>
                                    <ComboBoxItem Content="Large" Tag="large"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="Show on" VerticalAlignment="Center"/>
                                <ComboBox x:Name="MonitorBox" Grid.Row="1" Grid.Column="1" Margin="0,5" SelectionChanged="Changed"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Theme ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Theme"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="ACCENT COLOUR" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel x:Name="AccentSwatches" Margin="0,4"/>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="Custom (hex)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Border x:Name="AccentPreview" DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="11"
                                            Margin="10,0,0,0" BorderBrush="#55FFFFFF" BorderThickness="1"/>
                                    <TextBox x:Name="AccentHexBox" Style="{StaticResource Field}" Width="110" HorizontalAlignment="Left"
                                             LostFocus="Changed" KeyDown="Field_KeyDown" ToolTip="e.g. #FF9F0A"/>
                                </DockPanel>
                                <CheckBox x:Name="AccentBarsBox" Content="Colour the progress and volume bars too" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="Used for the open tool, timer, controller highlight and switches that are on."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="NOTCH" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Style" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NotchStyleBox" Grid.Column="1" Margin="0,5" SelectionChanged="Changed">
                                    <ComboBoxItem Content="Black (like a real notch)" Tag="black"/>
                                    <ComboBoxItem Content="Graphite" Tag="grey"/>
                                    <ComboBoxItem Content="Glass (see-through)" Tag="glass"/>
                                    <ComboBoxItem Content="Black with outline" Tag="outline"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="Width" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NotchWidthBox" Grid.Row="1" Grid.Column="1" Margin="0,5" SelectionChanged="Changed">
                                    <ComboBoxItem Content="Narrow" Tag="narrow"/>
                                    <ComboBoxItem Content="Normal" Tag="normal"/>
                                    <ComboBoxItem Content="Wide" Tag="wide"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Notch ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE737;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Notch"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="MUSIC" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="NowPlayingBox" Content="Now playing (song, controls, progress)" Click="Changed"/>
                                <CheckBox x:Name="SoundBarsBox" Content="Animated sound bars while playing" Click="Changed"/>
                                <CheckBox x:Name="PeekBox" Content="Pop open when the song changes" Click="Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="STATUS ICONS" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="WeatherBox" Content="Weather" Click="Changed"/>
                                <CheckBox x:Name="BatteryBox" Content="Battery" Click="Changed"/>
                                <CheckBox x:Name="PrivacyBox" Content="Camera and microphone in-use dots" Click="Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SYSTEM STATS" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="StatsBox" Content="Show system stats in the open notch" Click="Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                                    <CheckBox x:Name="StatsCpuBox" Content="CPU" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="StatsRamBox" Content="Memory" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="StatsNetBox" Content="Network speed" Click="Changed"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                           Text="Replaces the date line when nothing else is showing, and sits under everything else otherwise."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Pop-ups ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Pop-ups"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="SHOW A POP-UP FOR" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="VolumeBox" Content="Volume" Click="Changed"/>
                                <CheckBox x:Name="BrightnessBox" Content="Brightness (laptop screens)" Click="Changed"/>
                                <CheckBox x:Name="ChargingBox" Content="Charger plugged in" Click="Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Tools ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Tools"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="TIMER &amp; CLIPBOARD" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="TimerSoundBox" Content="Play a chime when a timer ends" Click="Changed"/>
                                <CheckBox x:Name="ClipboardBox" Content="Remember clipboard history (memory only)" Click="Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SCREENSHOTS" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Use" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox x:Name="ScreenshotBox" Grid.Column="1" Margin="0,5" SelectionChanged="Changed">
                                    <ComboBoxItem Content="Windows Snipping Tool" Tag="snipping"/>
                                    <ComboBoxItem Content="ShareX (Ctrl+PrintScreen)" Tag="sharex"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="MICROPHONE MUTE" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="MicButtonBox" Content="Mic mute button in the open notch" Click="Changed"/>
                                <DockPanel>
                                    <TextBlock Text="Shortcut (works everywhere)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="MicHotkeyBox" Style="{StaticResource Field}" Width="170" HorizontalAlignment="Right"
                                             LostFocus="Changed" KeyDown="Field_KeyDown" ToolTip="e.g. Ctrl+Alt+Shift+M — leave empty for none"/>
                                </DockPanel>
                                <CheckBox x:Name="MicDotBox" Content="Show a red mic icon on the notch while muted" Click="Changed"/>
                                <CheckBox x:Name="MicPopupBox" Content="Pop-up when muting / unmuting" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="Mutes every microphone in Windows itself, so Teams, Discord, Zoom and games all go quiet."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="QUICK NOTES" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="NotesEnabledBox" Content="Notes button in the open notch" Click="Changed"/>
                                <DockPanel>
                                    <TextBlock Text="Text size" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="NotesSizeBox" Width="170" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed">
                                        <ComboBoxItem Content="Small" Tag="small"/>
                                        <ComboBoxItem Content="Normal" Tag="normal"/>
                                        <ComboBoxItem Content="Large" Tag="large"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <Button Content="Open notes file" Click="OpenNotes_Click" DockPanel.Dock="Right" Padding="12,4"/>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                               Text="Saved as you type to notes.txt in %AppData%\WinNotch."/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="CALCULATOR &amp; CONVERTER" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="CalcEnabledBox" Content="Calculator button in the open notch" Click="Changed"/>
                                <CheckBox x:Name="CalcCurrencyBox" Content="Currency conversion (fetches daily rates online)" Click="Changed"/>
                                <CheckBox x:Name="CalcCopyBox" Content="Enter copies the answer" Click="Changed"/>
                                <DockPanel>
                                    <TextBlock Text="Decimal places" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CalcDecimalsBox" Width="170" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed">
                                        <ComboBoxItem Content="0" Tag="0"/>
                                        <ComboBoxItem Content="2" Tag="2"/>
                                        <ComboBoxItem Content="4" Tag="4"/>
                                        <ComboBoxItem Content="6" Tag="6"/>
                                        <ComboBoxItem Content="8" Tag="8"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="Try: 12*4+3 · 15% of 80 · sqrt(2) · 5 ft in cm · 70 f to c · 2 gb in mb · 20 usd to gbp · £50 in eur"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SHELF IMAGE ACTIONS" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ImageActionsBox" Content="Right-click an image on the shelf to convert, resize or compress it" Click="Changed"/>
                                <DockPanel>
                                    <TextBlock Text="Resize to width (px)" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ResizeWidthBox" Style="{StaticResource Field}" Width="170" HorizontalAlignment="Right"
                                             LostFocus="Changed" KeyDown="Field_KeyDown"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="JPG quality" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="JpegQualityText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <Slider x:Name="JpegQualitySlider" Width="130" HorizontalAlignment="Right" Minimum="10" Maximum="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            ValueChanged="JpegQuality_ValueChanged"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Save new images" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="ImageOutputBox" Width="170" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed">
                                        <ComboBoxItem Content="Next to the original" Tag="beside"/>
                                        <ComboBoxItem Content="Pictures\WinNotch" Tag="folder"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="QUICK ACTIONS" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Button Content="Edit…" Click="EditActions_Click" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,4,12,4"
                                           Text="The buttons that appear for Photoshop, Word, Discord, Claude and other apps."/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Bubbles ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA3A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Bubbles"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <CheckBox x:Name="BubblesBox" Content="Show bubbles around the open notch" Margin="2,14,0,6" Click="Changed"/>

                        <DockPanel Margin="2,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="TallPreviewButton" Content="Tall" Padding="10,3" Click="PreviewTall_Click"
                                        ToolTip="The open notch with lots showing (music, shelf…)"/>
                                <Button x:Name="ShortPreviewButton" Content="Short" Padding="10,3" Margin="4,0,0,0" Click="PreviewShort_Click"
                                        ToolTip="The open notch with little showing"/>
                                <Button x:Name="MiniPreviewButton" Content="Mini" Padding="10,3" Margin="4,0,0,0" Click="PreviewMini_Click"
                                        ToolTip="The open notch showing just the date (one bubble per side)"/>
                                <Button x:Name="CopyTallButton" Content="Copy tall" Padding="10,3" Margin="4,0,0,0" Click="CopyTall_Click"
                                        Visibility="Collapsed" ToolTip="Make this layout match the tall one"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Tall, Short and Mini each have their own layout. Drag to arrange, click to edit."
                                       TextWrapping="Wrap" Margin="0,0,8,0"/>
                        </DockPanel>

                        <!-- Live preview of the open notch: drag the bubbles around it -->
                        <Border Background="#141414" CornerRadius="8" Padding="0,0,0,8">
                            <Canvas x:Name="BubbleCanvas" Width="320" Height="260" HorizontalAlignment="Center"/>
                        </Border>

                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="AddBubbleButton" DockPanel.Dock="Left" Padding="12,5" Click="AddBubble_Click"
                                    ToolTip="Add a ready-made bubble or your own">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add bubble"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="BubbleHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Click a bubble to change its name, icon or what it opens."/>
                        </DockPanel>

                        <Border x:Name="BubbleEditor" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Name" VerticalAlignment="Center"/>
                                <TextBox x:Name="BubbleLabelBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                         Background="#333333" Foreground="White" CaretBrush="White" BorderBrush="#484848"
                                         Padding="4,3" LostFocus="BubbleFields_Commit" KeyDown="BubbleFields_KeyDown"/>
                                <TextBlock Grid.Row="1" Text="Opens" VerticalAlignment="Center"/>
                                <TextBox x:Name="BubbleTargetBox" Grid.Row="1" Grid.Column="1" Margin="0,4,6,4"
                                         Background="#333333" Foreground="White" CaretBrush="White" BorderBrush="#484848"
                                         Padding="4,3" ToolTip="A folder, an app (e.g. notepad.exe) or a link"
                                         LostFocus="BubbleFields_Commit" KeyDown="BubbleFields_KeyDown"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="…" Padding="10,3" ToolTip="Choose a folder"
                                        Click="BubbleBrowse_Click"/>
                                <TextBlock Grid.Row="2" Text="Icon" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                <WrapPanel x:Name="BubbleIconPicker" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>
                                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,6,0,0"
                                        Padding="12,5" Click="RemoveBubble_Click" ToolTip="Delete this bubble from both layouts">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Remove bubble" Foreground="#FF6B6B"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Handheld ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Handheld"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="HANDHELD MODE" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="HandheldBox" Content="Handheld gaming PC mode" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                           Text="Tap to open, controller support (hold View + Menu), bigger buttons, battery details, low battery warnings, quick switches and sliders, Steam / Xbox buttons."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="YOUR DEVICE" Style="{StaticResource Heading}"/>
                        <Border x:Name="DeviceCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel x:Name="DevicePicker"/>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock Text="Open-notch shortcut" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="HandheldHotkeyBox" Style="{StaticResource Field}" Width="170" HorizontalAlignment="Right"
                                             LostFocus="Changed" KeyDown="Field_KeyDown" ToolTip="e.g. Ctrl+Alt+N"/>
                                </DockPanel>
                                <TextBlock x:Name="DeviceTip" Style="{StaticResource Hint}" Margin="0,4,0,6"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="AUTOMATIC" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="AutoProfileBox" Content="Switch when plugging in / unplugging" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                           Text="Plugged in: max Hz + Performance. On battery: 60 Hz + Efficiency."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Features ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Features"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <DockPanel Margin="2,14,0,8">
                            <Button Content="View on GitHub" Click="OpenGitHub_Click" DockPanel.Dock="Right" Padding="12,4"/>
                            <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <TextBox x:Name="FeaturesText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="#DDDDDD" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     TextWrapping="Wrap" IsTabStop="False"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#171717" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button Click="QuitApp_Click" Padding="14,6" Margin="0,0,14,0"
                        ToolTip="Close WinNotch completely (the notch and the tray icon)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Quit WinNotch" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Changes save automatically"/>
                <Button Content="Close" Click="Done_Click" DockPanel.Dock="Right" Padding="22,6"
                        IsCancel="True" ToolTip="Close Settings (Esc)"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
