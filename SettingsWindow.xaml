<Window x:Class="WinNotch.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch Settings"
        Width="1100" Height="600"
        MinWidth="700" MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#1C1C1C" Foreground="White"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <!-- Replaced with your accent colour from Settings → Theme -->
        <SolidColorBrush x:Key="Accent" Color="#FF9F0A"/>

        <!-- Tick boxes and round choices in the accent colour -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center"
                                    Background="#2E2E2E" BorderBrush="#5A5A5A" BorderThickness="1">
                                <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" Foreground="Black" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8A8A8A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="#2E2E2E" Stroke="#5A5A5A" StrokeThickness="1"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="Black" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#8A8A8A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#333333" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#444444"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#484848"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Each page scrolls on its own -->
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="Padding" Value="16,0,16,16"/>
        </Style>

        <!-- Sidebar tabs -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Margin="8,2" Height="34">
                            <Border x:Name="Bg" CornerRadius="6" Background="Transparent"/>
                            <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Accent}"
                                    HorizontalAlignment="Left" Visibility="Collapsed"/>
                            <ContentPresenter ContentSource="Header" Margin="12,0,8,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262626"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E2E2E"/>
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#171717">
                                <StackPanel IsItemsHost="True" Margin="0,10,0,0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs">

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="General"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="STARTUP" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="StartWithWindowsBox" Content="Start with Windows" Click="Changed"/>
                                <CheckBox x:Name="HideInFullscreenBox" Content="Hide on full screen apps, games and videos" Click="Changed"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="UPDATES" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates_Click"
                                            DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,4"/>
                                    <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically" Click="Changed"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="GitHub repo" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="UpdateRepoBox" Style="{StaticResource Field}" Width="220" HorizontalAlignment="Right"
                                             LostFocus="Changed" KeyDown="Field_KeyDown" ToolTip="owner/repo"/>
                                </DockPanel>
                                <TextBlock x:Name="UpdateVersionText" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="NOTCH" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="SizeBox" Width="200" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed">
                                        <ComboBoxItem Content="Small" Tag="small"/>
                                        <ComboBoxItem Content="Normal" Tag="normal"/>
                                        <ComboBoxItem Content="Large" Tag="large"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Show on" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="MonitorBox" Width="200" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed"/>
                                </DockPanel>
                                <CheckBox x:Name="SecondsBox" Content="Show seconds on the clock" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="Closed: the date (DD/MM/YYYY) on the left, the time (24-hour) on the right. Hover to open it."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>


            <!-- ============ Theme ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Theme"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="ACCENT COLOUR" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <WrapPanel x:Name="AccentSwatches" Margin="0,4"/>
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock Text="Custom (hex)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Border x:Name="AccentPreview" DockPanel.Dock="Right" Width="22" Height="22" CornerRadius="11"
                                            Margin="10,0,0,0" BorderBrush="#55FFFFFF" BorderThickness="1"/>
                                    <TextBox x:Name="AccentHexBox" Style="{StaticResource Field}" Width="110" HorizontalAlignment="Left"
                                             LostFocus="Changed" KeyDown="Field_KeyDown" ToolTip="e.g. #FF9F0A"/>
                                </DockPanel>
                                <CheckBox x:Name="AccentBarsBox" Content="Colour the usage bars with it too (high usage still shows orange / red)" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="Used for the search box cursor, these Settings and (optionally) the usage bars."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="NOTCH" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Style" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NotchStyleBox" Grid.Column="1" Margin="0,5" SelectionChanged="Changed">
                                    <ComboBoxItem Content="Black (like a real notch)" Tag="black"/>
                                    <ComboBoxItem Content="Graphite" Tag="grey"/>
                                    <ComboBoxItem Content="Glass (see-through)" Tag="glass"/>
                                    <ComboBoxItem Content="Black with outline" Tag="outline"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Text="Width" VerticalAlignment="Center"/>
                                <ComboBox x:Name="NotchWidthBox" Grid.Row="1" Grid.Column="1" Margin="0,5" SelectionChanged="Changed">
                                    <ComboBoxItem Content="Narrow" Tag="narrow"/>
                                    <ComboBoxItem Content="Normal" Tag="normal"/>
                                    <ComboBoxItem Content="Wide" Tag="wide"/>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Search"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="SEARCH BOX" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Shortcut to open it (works everywhere)" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" Width="200" HorizontalAlignment="Right"
                                             LostFocus="Changed" KeyDown="Field_KeyDown" ToolTip="e.g. Ctrl+Alt+Space — leave empty for none"/>
                                </DockPanel>
                                <CheckBox x:Name="WindowsSearchBox" Content="Search the whole PC using the Windows Search index (fast)" Click="Changed"/>
                                <TextBlock Text="Also look in these folders (one per line)" Margin="0,8,0,2"/>
                                <TextBox x:Name="FoldersBox" Style="{StaticResource Field}" AcceptsReturn="True" Height="70"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" LostFocus="Changed"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="AI TOOL" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Ask" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="AiBox" Width="200" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed"/>
                                </DockPanel>
                                <DockPanel x:Name="CustomAiRow">
                                    <TextBlock Text="Custom link" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="CustomAiBox" Style="{StaticResource Field}" LostFocus="Changed" KeyDown="Field_KeyDown"
                                             ToolTip="Put {query} where the text should go, e.g. https://example.com/chat?q={query}"/>
                                </DockPanel>
                                <CheckBox x:Name="ClaudeAppBox" Content="Open Claude in the desktop app when it's installed" Click="Changed"/>
                                <TextBlock x:Name="AiHint" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="WEB SEARCH" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Search with" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="EngineBox" Width="200" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed"/>
                                </DockPanel>
                                <DockPanel x:Name="CustomWebRow">
                                    <TextBlock Text="Custom link" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="CustomWebBox" Style="{StaticResource Field}" LostFocus="Changed" KeyDown="Field_KeyDown"
                                             ToolTip="Put {query} where the text should go"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="In the search box: Enter opens the highlighted result, Shift+Enter searches the web, Ctrl+Enter asks the AI tool. Right-click a file to show it in its folder."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>




            <!-- ============ Home page ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Home page"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="2,12,0,0"
                                   Text="What shows under the search box on the first page of the open notch. It all steps aside while you're searching."/>

                        <TextBlock Text="QUOTE" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <CheckBox x:Name="ShowQuoteBox" Content="Quote of the day under the search box" Click="Changed"/>
                        </Border>

                        <TextBlock Text="WEATHER" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="WeatherBox" Content="Show the weather (from Open-Meteo, free - no account needed)" Click="Changed"/>
                                <DockPanel Margin="22,0,0,0">
                                    <TextBlock Text="Town" VerticalAlignment="Center" Width="90"/>
                                    <Button x:Name="WeatherFindButton" Content="Find" DockPanel.Dock="Right" Click="WeatherFind_Click" Margin="8,0,0,0" Padding="16,5"/>
                                    <TextBox x:Name="WeatherPlaceBox" Style="{StaticResource Field}" KeyDown="WeatherPlaceBox_KeyDown"/>
                                </DockPanel>
                                <TextBlock x:Name="WeatherStatus" Style="{StaticResource Hint}" Margin="112,0,0,4"
                                           Text="Type a town and press Find - add the country if there's more than one, e.g. Newport, Wales"/>
                                <DockPanel Margin="22,0,0,0">
                                    <TextBlock Text="Units" VerticalAlignment="Center" Width="90"/>
                                    <ComboBox x:Name="WeatherUnitBox" Width="200" HorizontalAlignment="Left" Margin="0,5" SelectionChanged="Changed">
                                        <ComboBoxItem Content="°C (Celsius)" Tag="c"/>
                                        <ComboBoxItem Content="°F (Fahrenheit)" Tag="f"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="CALENDAR" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="CalendarBox" Content="Show what's next in your calendar" Click="Changed"/>
                                <TextBlock Text="Calendar links (ICS) - one per line" Margin="22,6,0,0"/>
                                <TextBox x:Name="CalendarUrlsBox" Style="{StaticResource Field}" Margin="22,5,0,5" Height="64"
                                         AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" LostFocus="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6">
                                    <Run Text="Outlook: Settings → Calendar → Shared calendars → Publish a calendar → copy the ICS link."/>
                                    <LineBreak/>
                                    <Run Text="Google: Calendar settings → your calendar → Integrate calendar → Secret address in iCal format."/>
                                    <LineBreak/>
                                    <Run Text="iCloud: Calendar → share icon → Public Calendar → copy link. The link is private to you - treat it like a password."/>
                                </TextBlock>
                                <CheckBox x:Name="CalendarCountdownBox" Content="Count down to the next event on the closed notch (uses the countdown time from the Reminders tab)" Margin="22,5,0,5" Click="Changed"/>
                                <DockPanel Margin="22,0,0,4">
                                    <Button Content="Refresh now" Click="CalendarRefresh_Click" HorizontalAlignment="Left" Padding="12,4"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DAY PROGRESS" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="DayProgressBox" Content="Show how much of the day has gone (a thin bar)" Click="Changed"/>
                                <CheckBox x:Name="WeekNumberBox" Content="Show the week number" Margin="22,5,0,5" Click="Changed"/>
                                <DockPanel Margin="22,0,0,0">
                                    <TextBlock Text="Measure" VerticalAlignment="Center" Width="90"/>
                                    <ComboBox x:Name="DayProgressModeBox" Width="200" HorizontalAlignment="Left" Margin="0,5" SelectionChanged="Changed">
                                        <ComboBoxItem Content="My working day" Tag="work"/>
                                        <ComboBoxItem Content="The whole day" Tag="day"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="22,0,0,0">
                                    <TextBlock Text="Work hours" VerticalAlignment="Center" Width="90"/>
                                    <TextBox x:Name="WorkStartBox" Style="{StaticResource Field}" Width="80" LostFocus="Changed" KeyDown="Field_KeyDown"/>
                                    <TextBlock Text="to" VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBox x:Name="WorkEndBox" Style="{StaticResource Field}" Width="80" HorizontalAlignment="Left" LostFocus="Changed" KeyDown="Field_KeyDown"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="112,0,0,4" Text="Weekends always show the whole day."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="QUICK TOGGLES" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="QuickTogglesBox" Content="Row of quick toggles (they light up in your accent colour when on)" Click="Changed"/>
                                <CheckBox x:Name="ToggleMicBox" Content="Mute microphone" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ToggleDndBox" Content="Do not disturb" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ToggleThemeBox" Content="Dark / light mode" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ToggleBluetoothBox" Content="Bluetooth on / off" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ToggleAwakeBox" Content="Keep the PC and screen awake" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ToggleLockBox" Content="Lock the PC" Margin="22,5,0,5" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,6"
                                           Text="Windows doesn't give apps a proper switch for Do not disturb, so the notch tries Windows' own setting and, if Windows won't take it, opens the notification settings for you. Keep awake lasts until you turn it off or close WinNotch."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SYSTEM INFO" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ShowStatsBox" Content="Show system info under the search box" Click="Changed"/>
                                <CheckBox x:Name="CompactStatsBox" Content="Make it smaller (one line)" Margin="22,5,0,5" Click="Changed"/>
                                <WrapPanel Margin="22,0,0,4">
                                    <CheckBox x:Name="CpuBox" Content="CPU" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="MemoryBox" Content="Memory" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="GpuBox" Content="GPU" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="DiskBox" Content="Disk" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="NetworkBox" Content="Network" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="BatteryBox" Content="Battery" Click="Changed" Margin="0,5,18,5"/>
                                    <CheckBox x:Name="UptimeBox" Content="Up time" Click="Changed" Margin="0,5,18,5"/>
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                           Text="Battery only shows on laptops and handhelds. GPU is the 3D engine use, like Task Manager."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DISK TILE" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Drives to show - click the disk tile in the notch to flick between them" Margin="0,4,0,2"/>
                                <WrapPanel x:Name="DrivesPanel" Margin="0,2,0,0"/>
                                <DockPanel Margin="0,6,0,4">
                                    <TextBlock Text="Add a drive letter" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Content="Add" Click="AddDrive_Click" DockPanel.Dock="Right" Padding="14,4" Margin="8,0,0,0"/>
                                    <TextBox x:Name="AddDriveBox" Style="{StaticResource Field}" Width="60" HorizontalAlignment="Left"
                                             MaxLength="2" KeyDown="AddDriveBox_KeyDown" ToolTip="e.g. F - for a USB drive that isn't plugged in now"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="Tick the drives you want. Ones that aren't plugged in show as 'Not connected' in the tile."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Music"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="MUSIC PAGE IN THE NOTCH" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="MusicPageBox" Content="Music controls page (its own bubble under the open notch)" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                           Text="Artwork, song, artist and album, a progress bar you can click or drag, and shuffle / previous / play / next / repeat. Works with anything that shows in Windows' media controls. Click the app name to switch between apps that are playing."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="YOUR MUSIC SERVICE" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Service" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="MusicServiceBox" Width="220" HorizontalAlignment="Right" Margin="0,5"
                                              SelectionChanged="Changed"/>
                                </DockPanel>
                                <CheckBox x:Name="MusicExtrasBox" Content="Show extra buttons for the service" Click="Changed"/>
                                <TextBlock x:Name="MusicServiceHint" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Volume"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="VOLUME PAGE IN THE NOTCH" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="VolumePageBox" Content="Volume controls page (its own bubble under the open notch)" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,0,0,6"
                                           Text="Click the speaker bubble under the open notch for the whole-PC volume and a slider and mute button for each app making sound. The date, time and search box stay put."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Shelf"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="SHELF PAGE IN THE NOTCH" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="ShelfPageBox" Content="Shelf: drop files on the notch to keep them, drag them out again" Click="Changed"/>
                                <CheckBox x:Name="ShelfAutoOpenBox" Content="Open the shelf when a file is dragged onto the notch" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ShelfRememberBox" Content="Keep the shelf when WinNotch restarts" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ShelfThumbsBox" Content="Show previews for pictures" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ShelfRemoveBox" Content="Take things off the shelf once they've been dragged out" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ShelfScreenshotsBox" Content="Put screenshots on the shelf (Snipping Tool, Win+Shift+S, PrintScreen, ShareX)" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ShelfPeekBox" Content="Pop the notch open to show a new screenshot" Margin="44,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ShelfScratchBox" Content="Scratch pad under the shelf (quick notes, saved as you type)" Margin="22,5,0,5" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,6"
                                           Text="Click the shelf bubble under the open notch to see it. Dragging out works like File Explorer: it moves on the same drive and copies to another - hold Ctrl to copy or Shift to move. Double-click to open, right-click for more."/>
                                <DockPanel Margin="22,0,0,6">
                                    <Button Content="Clear the shelf" Click="ClearShelf_Click" HorizontalAlignment="Left" Padding="12,4"/>
                                    <Button Content="Open scratch pad file" Click="OpenScratch_Click" HorizontalAlignment="Left" Padding="12,4" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Reminders ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Reminders"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="REMINDERS" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="RemindersBox" Content="Set reminders by typing them in the search box" Click="Changed"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="22,2,0,6"
                                           Text="Try: timer 10 min · remind me in 20 min to check the oven · remind me at 5pm call mum · remind me tomorrow 9am bins · remind me on friday at 3pm dentist · every weekday at 9am stand-up · every day 8pm meds · every 45 min stretch"/>
                                <CheckBox x:Name="ReminderSoundBox" Content="Play a sound when a reminder is due" Margin="22,5,0,5" Click="Changed"/>
                                <CheckBox x:Name="ReminderFullscreenBox" Content="Show due reminders over full-screen apps and games" Margin="22,5,0,5" Click="Changed"/>
                                <DockPanel Margin="22,0,0,0">
                                    <TextBlock Text="Countdown on the closed notch" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ComboBox x:Name="ReminderCountdownBox" Width="200" HorizontalAlignment="Right" Margin="0,5" SelectionChanged="Changed">
                                        <ComboBoxItem Content="Off" Tag="0"/>
                                        <ComboBoxItem Content="15 minutes before" Tag="15"/>
                                        <ComboBoxItem Content="30 minutes before" Tag="30"/>
                                        <ComboBoxItem Content="1 hour before" Tag="60"/>
                                        <ComboBoxItem Content="2 hours before" Tag="120"/>
                                    </ComboBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="ADD A REMINDER" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Remind me to" VerticalAlignment="Center" Margin="0,0,12,0" Width="110"/>
                                    <TextBox x:Name="NewReminderText" Style="{StaticResource Field}" KeyDown="NewReminder_KeyDown"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="Repeat" VerticalAlignment="Center" Margin="0,0,12,0" Width="110"/>
                                    <ComboBox x:Name="NewReminderRepeat" Width="220" HorizontalAlignment="Left" Margin="0,5"
                                              SelectionChanged="NewReminderRepeat_Changed">
                                        <ComboBoxItem Content="Once" Tag="none" IsSelected="True"/>
                                        <ComboBoxItem Content="Every day" Tag="daily"/>
                                        <ComboBoxItem Content="Every weekday (Mon-Fri)" Tag="weekdays"/>
                                        <ComboBoxItem Content="Every week" Tag="weekly"/>
                                        <ComboBoxItem Content="Every few minutes / hours" Tag="interval"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel x:Name="NewReminderDayRow">
                                    <TextBlock x:Name="NewReminderDayLabel" Text="Day" VerticalAlignment="Center" Margin="0,0,12,0" Width="110"/>
                                    <ComboBox x:Name="NewReminderDay" Width="220" HorizontalAlignment="Left" Margin="0,5"/>
                                </DockPanel>
                                <DockPanel x:Name="NewReminderTimeRow">
                                    <TextBlock Text="Time" VerticalAlignment="Center" Margin="0,0,12,0" Width="110"/>
                                    <TextBox x:Name="NewReminderTime" Style="{StaticResource Field}" Width="220" HorizontalAlignment="Left"
                                             Text="09:00" KeyDown="NewReminder_KeyDown"/>
                                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Text="e.g. 17:30, 5:30pm, noon"/>
                                </DockPanel>
                                <DockPanel x:Name="NewReminderEveryRow" Visibility="Collapsed">
                                    <TextBlock Text="Every" VerticalAlignment="Center" Margin="0,0,12,0" Width="110"/>
                                    <TextBox x:Name="NewReminderEvery" Style="{StaticResource Field}" Width="80" HorizontalAlignment="Left"
                                             Text="45" KeyDown="NewReminder_KeyDown"/>
                                    <ComboBox x:Name="NewReminderEveryUnit" Width="130" HorizontalAlignment="Left" Margin="8,5,0,5">
                                        <ComboBoxItem Content="minutes" Tag="1" IsSelected="True"/>
                                        <ComboBoxItem Content="hours" Tag="60"/>
                                    </ComboBox>
                                </DockPanel>
                                <DockPanel Margin="0,6,0,2">
                                    <Button Content="Add reminder" Click="AddReminder_Click" DockPanel.Dock="Right" Padding="16,6"/>
                                    <TextBlock x:Name="NewReminderStatus" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="COMING UP" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel x:Name="ReminderList"/>
                                <TextBlock x:Name="ReminderListEmpty" Style="{StaticResource Hint}" Margin="0,6"
                                           Text="No reminders set. Open the notch and type one in the search box."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Bubbles ============ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA3A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="Bubbles"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <CheckBox x:Name="BubblesBox" Content="Show bubbles around the open notch" Margin="2,14,0,6" Click="Changed"/>

                        <DockPanel Margin="2,0,0,6">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button x:Name="TallPreviewButton" Content="Tall" Padding="10,3" Click="PreviewTall_Click"
                                        ToolTip="The open notch with lots showing (music, shelf…)"/>
                                <Button x:Name="ShortPreviewButton" Content="Short" Padding="10,3" Margin="4,0,0,0" Click="PreviewShort_Click"
                                        ToolTip="The open notch with little showing"/>
                                <Button x:Name="MiniPreviewButton" Content="Mini" Padding="10,3" Margin="4,0,0,0" Click="PreviewMini_Click"
                                        ToolTip="The open notch showing just the date (one bubble per side)"/>
                                <Button x:Name="CopyTallButton" Content="Copy tall" Padding="10,3" Margin="4,0,0,0" Click="CopyTall_Click"
                                        Visibility="Collapsed" ToolTip="Make this layout match the tall one"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Tall, Short and Mini each have their own layout. Drag to arrange, click to edit."
                                       TextWrapping="Wrap" Margin="0,0,8,0"/>
                        </DockPanel>

                        <!-- Live preview of the open notch: drag the bubbles around it -->
                        <Border Background="#141414" CornerRadius="8" Padding="0,0,0,8">
                            <Canvas x:Name="BubbleCanvas" Width="320" Height="260" HorizontalAlignment="Center"/>
                        </Border>

                        <DockPanel Margin="0,8,0,0">
                            <Button x:Name="AddBubbleButton" DockPanel.Dock="Left" Padding="12,5" Click="AddBubble_Click"
                                    ToolTip="Add a ready-made bubble or your own">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add bubble"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="BubbleHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       Text="Click a bubble to change its name, icon or what it opens."/>
                        </DockPanel>

                        <Border x:Name="BubbleEditor" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Name" VerticalAlignment="Center"/>
                                <TextBox x:Name="BubbleLabelBox" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"
                                         Background="#333333" Foreground="White" CaretBrush="White" BorderBrush="#484848"
                                         Padding="4,3" LostFocus="BubbleFields_Commit" KeyDown="BubbleFields_KeyDown"/>
                                <TextBlock Grid.Row="1" Text="Opens" VerticalAlignment="Center"/>
                                <TextBox x:Name="BubbleTargetBox" Grid.Row="1" Grid.Column="1" Margin="0,4,6,4"
                                         Background="#333333" Foreground="White" CaretBrush="White" BorderBrush="#484848"
                                         Padding="4,3" ToolTip="A folder, an app (e.g. notepad.exe) or a link"
                                         LostFocus="BubbleFields_Commit" KeyDown="BubbleFields_KeyDown"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="…" Padding="10,3" ToolTip="Choose a folder"
                                        Click="BubbleBrowse_Click"/>
                                <TextBlock Grid.Row="2" Text="Icon" VerticalAlignment="Top" Margin="0,8,0,0"/>
                                <WrapPanel x:Name="BubbleIconPicker" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,4"/>
                                <Button Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,6,0,0"
                                        Padding="12,5" Click="RemoveBubble_Click" ToolTip="Delete this bubble from both layouts">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Remove bubble" Foreground="#FF6B6B"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,1,10,0"/>
                        <TextBlock Text="About"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource Page}">
                    <StackPanel>
                        <TextBlock Text="ABOUT" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,4">
                                    <Button Content="View on GitHub" Click="OpenGitHub_Click" DockPanel.Dock="Right" Padding="12,4"/>
                                    <TextBlock x:Name="VersionText" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                                           Text="Settings, reminders, the shelf and the scratch pad are saved in %AppData%\WinNotch. Version 1's files are kept in a v1-backup folder there."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="RELEASE NOTES" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,4,0,6">
                                    <ComboBox x:Name="ReleaseBox" Width="260" HorizontalAlignment="Left" Margin="0,5"
                                              SelectionChanged="ReleaseBox_Changed"/>
                                    <TextBlock x:Name="ReleaseInfoText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="Loading from GitHub…"/>
                                </DockPanel>
                                <TextBox x:Name="ReleaseNotesText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                         Foreground="#DDDDDD" FontSize="12.5" TextWrapping="Wrap" IsTabStop="False" Margin="0,0,0,6"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="FEATURES" Style="{StaticResource Heading}"/>
                        <Border Style="{StaticResource Card}" Padding="16,12">
                            <TextBox x:Name="FeaturesText" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     Foreground="#DDDDDD" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     TextWrapping="Wrap" IsTabStop="False"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#171717" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button Click="QuitApp_Click" Padding="14,6" Margin="0,0,14,0" ToolTip="Close WinNotch completely">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="#FF6B6B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Quit WinNotch" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="RestartApp_Click" Padding="14,6" Margin="0,0,14,0" ToolTip="Close WinNotch and start it again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Restart WinNotch" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- For testing while it's being built: remove later -->
                <Button x:Name="HardRestartButton" Click="HardRestart_Click" Padding="14,6" Margin="0,0,14,0"
                        ToolTip="Quits, re-runs run.bat (rebuilds from the code) and opens Settings again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEBE8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="#FFD60A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Hard restart (debug)" Foreground="#FFD60A" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Changes save automatically"/>
                <Button Content="Close" Click="Done_Click" DockPanel.Dock="Right" Padding="22,6" IsCancel="True"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
