<Window x:Class="WinNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch"
        Width="440" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Round, icon-only buttons -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="19">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small tool icons along the top-left of the open notch -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Tiles for the quick-action buttons -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A1A1A" CornerRadius="10" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-shaped text buttons (timer presets, modes) -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1F1F1F" CornerRadius="13" Padding="11,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2E2E2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in the clipboard history -->
        <Style x:Key="ClipItemButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#1A1A1A" CornerRadius="8" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ROG Ally mode: bigger finger-friendly buttons -->
        <Style x:Key="AllyChip" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>

        <!-- Slim sliders for brightness and volume -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="White"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="30" Background="Transparent">
                            <Border Height="6" CornerRadius="3" Background="#33FFFFFF" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round bubbles around the open notch -->
        <Style x:Key="BubbleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="21"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262626"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
    <!-- The notch itself -->
    <Border x:Name="Pill"
            Width="220" Height="34"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="Black"
            CornerRadius="0,0,16,16"
            ClipToBounds="True"
            MouseEnter="Pill_MouseEnter"
            MouseLeave="Pill_MouseLeave"
            PreviewTouchDown="Pill_PreviewTouchDown"
            AllowDrop="True"
            DragEnter="Pill_DragEnter"
            DragOver="Pill_DragOver"
            DragLeave="Pill_DragLeave"
            Drop="Pill_Drop">

        <Grid x:Name="PillRoot">
            <!-- ============ Collapsed view: left side ============ -->
            <StackPanel x:Name="CompactView" Orientation="Horizontal" Height="34" Margin="10,0,0,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="5"
                        VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Bouncing sound bars while music plays -->
                <StackPanel x:Name="SoundBars" Orientation="Horizontal" Height="14" Margin="7,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Rectangle Width="2.5" Height="14" Margin="0,0,1.5,0" RadiusX="1" RadiusY="1" Fill="White"
                               RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="2.5" Height="14" Margin="0,0,1.5,0" RadiusX="1" RadiusY="1" Fill="White"
                               RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="2.5" Height="14" Margin="0,0,1.5,0" RadiusX="1" RadiusY="1" Fill="White"
                               RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="2.5" Height="14" RadiusX="1" RadiusY="1" Fill="White"
                               RenderTransformOrigin="0.5,1">
                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                </StackPanel>

                <!-- Download speed (ROG Ally mode) -->
                <StackPanel x:Name="CompactDownload" Orientation="Horizontal" Margin="2,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE896;" FontSize="12" Foreground="#34C759"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CompactDownloadText" FontSize="11" FontWeight="SemiBold" Foreground="White"
                               Margin="5,0,0,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Screen recording in progress (click the notch to stop) -->
                <StackPanel x:Name="CompactRec" Orientation="Horizontal" Margin="2,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse x:Name="CompactRecDot" Width="9" Height="9" Fill="#FF453A" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CompactRecText" Text="0:00" FontSize="12" FontWeight="SemiBold" Foreground="White"
                               Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Running timer -->
                <StackPanel x:Name="CompactTimer" Orientation="Horizontal" Margin="2,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="CompactTimerIcon" Text="&#xE916;" FontSize="12" Foreground="#FF9F0A"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CompactTimerText" Text="0:00" FontSize="12" FontWeight="SemiBold"
                               Foreground="White" Margin="5,0,0,0" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- ============ Open notch: tools (top-left) + message (top-centre) ============ -->
            <Grid x:Name="TopLeftBar" Height="34" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                <StackPanel x:Name="TopButtonsPanel" Orientation="Horizontal" Margin="12,0,0,0" HorizontalAlignment="Left">
                    <Button x:Name="CleanButton" Tag="clean" Style="{StaticResource ToolButton}"
                            ToolTip="Clean up junk files (temp files, crash dumps, browser caches)"
                            Click="CleanButton_Click">
                        <TextBlock x:Name="CleanIcon" Text="&#xE74D;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="TimerToolButton" Tag="timer" Style="{StaticResource ToolButton}" Content="&#xE916;"
                            ToolTip="Timer, stopwatch and Pomodoro" Click="TimerToolButton_Click"/>
                    <Button x:Name="ClipboardToolButton" Tag="clipboard" Style="{StaticResource ToolButton}" Content="&#xE77F;"
                            ToolTip="Clipboard history" Click="ClipboardToolButton_Click"/>
                    <Button Tag="colour" Style="{StaticResource ToolButton}" Content="&#xE790;"
                            ToolTip="Colour picker: click anywhere on screen to copy its colour"
                            Click="ColorPickerTool_Click"/>
                    <Button Tag="screenshot" Style="{StaticResource ToolButton}" Content="&#xE722;"
                            ToolTip="Screenshot to shelf" Click="ScreenshotTool_Click"/>
                    <Button x:Name="ClaudeToolButton" Tag="claude" Style="{StaticResource ToolButton}" Content="&#xE8BD;"
                            ToolTip="Claude" Click="ClaudeToolButton_Click"/>
                    <Button x:Name="MicToolButton" Tag="mic" Style="{StaticResource ToolButton}" Content="&#xE720;"
                            ToolTip="Mute / unmute your microphone (every app)" Click="MicToolButton_Click"/>
                    <Button x:Name="NotesToolButton" Tag="notes" Style="{StaticResource ToolButton}" Content="&#xE70B;"
                            ToolTip="Quick notes" Click="NotesToolButton_Click"/>
                    <Button x:Name="MusicToolButton" Tag="music" Style="{StaticResource ToolButton}" Content="&#xE8D6;"
                            ToolTip="Music controls" Click="MusicToolButton_Click"/>
                    <Button x:Name="MixerToolButton" Tag="mixer" Style="{StaticResource ToolButton}" Content="&#xE9E9;"
                            ToolTip="Volume for each app" Click="MixerToolButton_Click"/>
                    <Button x:Name="SearchToolButton" Tag="search" Style="{StaticResource ToolButton}" Content="&#xE721;"
                            ToolTip="Search apps, files and scripts" Click="SearchToolButton_Click"/>
                    <Button x:Name="OcrToolButton" Tag="ocr" Style="{StaticResource ToolButton}" Content="&#xE8C8;"
                            ToolTip="Copy text from the screen" Click="OcrTool_Click"/>
                    <Button x:Name="RecordToolButton" Tag="record" Style="{StaticResource ToolButton}" Content="&#xE7C8;"
                            ToolTip="Record the screen (MP4 to the shelf)" Click="RecordTool_Click"/>
                    <Button x:Name="CalcToolButton" Tag="calc" Style="{StaticResource ToolButton}" Content="&#xE8EF;"
                            ToolTip="Calculator and converter" Click="CalcToolButton_Click"/>
                    <!-- Shown when there are more buttons than fit; opens the rest -->
                    <Button x:Name="MoreToolButton" Tag="more" Style="{StaticResource ToolButton}" Content="&#xE712;"
                            ToolTip="More tools" Click="MoreToolButton_Click" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock x:Name="TopMessage" Foreground="#A0A0A0" FontSize="11" Margin="250,0,120,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <!-- ============ Status (top-right, always visible) ============ -->
            <!-- Today's date, always shown under the buttons at the top of the open notch -->
            <TextBlock x:Name="DateText" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20,34,20,0"
                       Foreground="White" FontSize="13" FontWeight="SemiBold" Opacity="0" IsHitTestVisible="False"/>

            <StackPanel x:Name="StatusBar" Orientation="Horizontal" Height="34" Margin="0,0,16,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top">
                <!-- Privacy dots: camera (green) and microphone (orange) in use -->
                <!-- Microphone muted (system-wide) -->
                <TextBlock x:Name="MicMutedIcon" Text="&#xEC54;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12" Foreground="#FF453A" VerticalAlignment="Center" Margin="0,0,7,0"
                           ToolTip="Microphone muted" Visibility="Collapsed"/>
                <Ellipse x:Name="CameraDot" Width="7" Height="7" Fill="#34C759" Margin="0,0,5,0"
                         VerticalAlignment="Center" ToolTip="Camera in use" Visibility="Collapsed"/>
                <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" Margin="0,0,7,0"
                         VerticalAlignment="Center" ToolTip="Microphone in use" Visibility="Collapsed"/>

                <!-- Battery (hidden on PCs without a battery) -->
                <Grid x:Name="BatteryIcon" Width="24" Height="12" VerticalAlignment="Center"
                      Margin="0,0,8,0" Visibility="Collapsed">
                    <Border Width="21" Height="12" HorizontalAlignment="Left"
                            BorderBrush="#CCFFFFFF" BorderThickness="1.2" CornerRadius="3.5" Padding="1.5">
                        <Border x:Name="BatteryFill" HorizontalAlignment="Left" Width="10"
                                CornerRadius="1.5" Background="White"/>
                    </Border>
                    <Border Width="2" Height="5" HorizontalAlignment="Right" Margin="0,0,0.5,0"
                            CornerRadius="0,1,1,0" Background="#CCFFFFFF"/>
                    <Path x:Name="BatteryBolt" Visibility="Collapsed"
                          Data="M 11.5,0.3 L 6.4,6.8 L 9.8,6.8 L 8.6,11.7 L 13.6,5.2 L 10.2,5.2 Z"
                          Fill="White" Stroke="Black" StrokeThickness="0.8" StrokeLineJoin="Round"/>
                </Grid>

                <TextBlock x:Name="WeatherIcon" Foreground="White" FontSize="13"
                           FontFamily="Segoe UI Emoji, Segoe UI Symbol"
                           VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"/>
                <TextBlock x:Name="ClockText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ============ Pop-up (volume, brightness, charging, alerts) ============ -->
            <Grid x:Name="HudView" Height="34" VerticalAlignment="Top" Margin="14,0,16,0"
                  Opacity="0" IsHitTestVisible="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HudIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                           Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <Ellipse x:Name="HudSwatch" Width="14" Height="14" Stroke="#66FFFFFF" StrokeThickness="1"
                         VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                <!-- Screenshot thumbnail -->
                <Border x:Name="HudThumb" Width="30" Height="20" CornerRadius="3" Margin="-4,0,-4,0"
                        BorderBrush="#55FFFFFF" BorderThickness="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>

                <Grid Grid.Column="1" Margin="10,0">
                    <Grid x:Name="HudBar" Height="4" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="HudFillCol" Width="0.5*"/>
                            <ColumnDefinition x:Name="HudRestCol" Width="0.5*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="2" CornerRadius="2" Background="#33FFFFFF"/>
                        <Border x:Name="HudFill" CornerRadius="2" Background="White"/>
                    </Grid>
                    <TextBlock x:Name="HudText" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
                </Grid>

                <TextBlock x:Name="HudValue" Grid.Column="2" Foreground="#CCCCCC" FontSize="11"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
            </Grid>

            <!-- ============ Open notch: content ============ -->
            <Grid x:Name="ExpandedView" Opacity="0" IsHitTestVisible="False" Margin="18,60,18,16"
                  VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0: tool panel (timer / clipboard) -->
                    <RowDefinition Height="Auto"/>  <!-- 1: now playing -->
                    <RowDefinition Height="Auto"/>  <!-- 2: progress bar -->
                    <RowDefinition Height="Auto"/>  <!-- 3: quick actions -->
                    <RowDefinition Height="Auto"/>  <!-- 4: shelf -->
                    <RowDefinition Height="Auto"/>  <!-- 5: (spare) -->
                    <RowDefinition Height="Auto"/>  <!-- 6: system stats -->
                </Grid.RowDefinitions>

                <!-- == ROG Ally panel: battery, brightness, volume, quick switches == -->
                <StackPanel x:Name="AllyPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,12">
                    <DockPanel>
                        <TextBlock x:Name="AllyBatteryGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AllyStatsText" Margin="8,0,0,0" Foreground="#DDDDDD" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock x:Name="AllyInfoText" Foreground="#8A8A8A" FontSize="11" Margin="23,2,0,0"
                               TextTrimming="CharacterEllipsis"/>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BrightnessGlyph" Text="&#xE706;" FontSize="15" Foreground="White"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource NotchSlider}" ToolTip="Brightness"
                                ValueChanged="BrightnessSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeGlyph" Grid.Column="3" Text="&#xE767;" FontSize="15" Foreground="White"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                        <Slider x:Name="VolumeSlider" Grid.Column="4" Margin="8,0,0,0"
                                Style="{StaticResource NotchSlider}" ToolTip="Volume"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </Grid>

                    <!-- Power use over the last 30 minutes -->
                    <Grid Margin="0,6,0,0">
                        <Border Height="30" CornerRadius="6" Background="#141414"/>
                        <Canvas x:Name="PowerGraph" Height="30" Margin="4,0" ClipToBounds="True">
                            <Polyline x:Name="PowerLine" Stroke="#34C759" StrokeThickness="1.5"
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                        <TextBlock x:Name="PowerGraphLabel" Foreground="#8A8A8A" FontSize="10" Margin="8,3,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>

                    <UniformGrid Rows="1" Margin="-3,8,-3,0">
                        <Button x:Name="RefreshRateButton" Style="{StaticResource AllyChip}" Content="Hz"
                                ToolTip="Switch screen refresh rate (60 Hz saves battery)" Click="RefreshRate_Click"/>
                        <Button x:Name="PowerModeButton" Style="{StaticResource AllyChip}" Content="Balanced"
                                ToolTip="Windows power mode" Click="PowerMode_Click"/>
                        <Button Style="{StaticResource AllyChip}" Content="Keyboard"
                                ToolTip="On-screen keyboard" Click="Keyboard_Click"/>
                        <Button Style="{StaticResource AllyChip}" Content="Game Bar"
                                ToolTip="Xbox Game Bar (Win+G)" Click="GameBar_Click"/>
                    </UniformGrid>

                    <UniformGrid Rows="1" Margin="-3,6,-3,0">
                        <Button x:Name="WifiButton" Style="{StaticResource AllyChip}" Content="Wi-Fi"
                                ToolTip="Wi-Fi on / off" Click="Wifi_Click"/>
                        <Button x:Name="BluetoothButton" Style="{StaticResource AllyChip}" Content="Bluetooth"
                                ToolTip="Bluetooth on / off" Click="Bluetooth_Click"/>
                        <Button x:Name="AirplaneButton" Style="{StaticResource AllyChip}" Content="Airplane"
                                ToolTip="Airplane mode: turns off all wireless" Click="Airplane_Click"/>
                        <Button x:Name="ResolutionButton" Style="{StaticResource AllyChip}" Content="1080p"
                                ToolTip="Switch desktop resolution (720p for older games)" Click="Resolution_Click"/>
                    </UniformGrid>

                    <UniformGrid Rows="1" Margin="-3,6,-3,0">
                        <Button x:Name="KeepAwakeButton" Style="{StaticResource AllyChip}" Content="Stay awake"
                                ToolTip="Don't sleep (turns itself off when a download finishes)" Click="KeepAwake_Click"/>
                        <Button Style="{StaticResource AllyChip}" Content="Screen off"
                                ToolTip="Turn the screen off but keep running (tap or press a button to wake)"
                                Click="ScreenOff_Click"/>
                        <Button x:Name="GameProfileButton" Style="{StaticResource AllyChip}" Content="Save for game"
                                Visibility="Collapsed" Click="GameProfile_Click"/>
                    </UniformGrid>
                </StackPanel>

                <!-- == Timer / stopwatch / Pomodoro == -->
                <StackPanel x:Name="TimerPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ModeTimerButton" Style="{StaticResource ChipButton}" Content="Timer"
                                Tag="Timer" Click="TimerMode_Click"/>
                        <Button x:Name="ModeStopwatchButton" Style="{StaticResource ChipButton}" Content="Stopwatch"
                                Tag="Stopwatch" Click="TimerMode_Click"/>
                        <Button x:Name="ModePomodoroButton" Style="{StaticResource ChipButton}" Content="Pomodoro"
                                Tag="Pomodoro" Click="TimerMode_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TimerPhaseText" Foreground="#A0A0A0" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock x:Name="TimerBigText" Text="5:00" Foreground="White" FontSize="36" FontWeight="Light"
                               HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular"/>

                    <StackPanel x:Name="TimerPresets" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,4,0,0">
                        <Button Style="{StaticResource ChipButton}" Content="1 min" Tag="1" Click="TimerPreset_Click"/>
                        <Button Style="{StaticResource ChipButton}" Content="5 min" Tag="5" Click="TimerPreset_Click"/>
                        <Button Style="{StaticResource ChipButton}" Content="10 min" Tag="10" Click="TimerPreset_Click"/>
                        <Button Style="{StaticResource ChipButton}" Content="25 min" Tag="25" Click="TimerPreset_Click"/>
                        <Button Style="{StaticResource ChipButton}" Content="1 hr" Tag="60" Click="TimerPreset_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontSize="15"
                                ToolTip="Reset" Click="TimerReset_Click"/>
                        <Button x:Name="TimerStartButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                FontSize="20" Margin="10,0" ToolTip="Start / Pause" Click="TimerStart_Click"/>
                        <Button x:Name="TimerAddButton" Style="{StaticResource ChipButton}" Content="+1 min"
                                VerticalAlignment="Center" Click="TimerAdd_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- == Quick notes == -->
                <Grid x:Name="NotesPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,6">
                        <TextBlock x:Name="NotesSaved" DockPanel.Dock="Right" Foreground="#666666" FontSize="10"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="NOTES · saved automatically · Esc to close" Foreground="#888888" FontSize="10"
                                   FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBox x:Name="NotesBox" Grid.Row="1" Height="130" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#161616" Foreground="White" CaretBrush="White" BorderBrush="#33FFFFFF"
                             Padding="8,6" FontSize="13"
                             PreviewMouseDown="TextEntry_PreviewMouseDown" PreviewKeyDown="TextEntry_PreviewKeyDown"
                             TextChanged="NotesBox_TextChanged"/>
                </Grid>

                <!-- == Calculator / converter == -->
                <StackPanel x:Name="CalcPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <TextBlock Text="CALCULATE · e.g. 40 * 12, 5ft in cm, 150 usd in gbp · Enter copies" Foreground="#888888"
                               FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6" TextTrimming="CharacterEllipsis"/>
                    <TextBox x:Name="CalcBox" Height="34" FontSize="15"
                             Background="#161616" Foreground="White" CaretBrush="White" BorderBrush="#33FFFFFF"
                             Padding="8,4" VerticalContentAlignment="Center"
                             PreviewMouseDown="TextEntry_PreviewMouseDown" PreviewKeyDown="TextEntry_PreviewKeyDown"
                             TextChanged="CalcBox_TextChanged"/>
                    <TextBlock x:Name="CalcResult" Foreground="White" FontSize="24" FontWeight="Light" Margin="2,8,0,0"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CalcDetail" Foreground="#888888" FontSize="11" Margin="2,2,0,0"/>
                </StackPanel>

                <!-- == Clipboard history == -->
                <!-- == Tools that didn't fit along the top == -->
                <StackPanel x:Name="MorePanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <TextBlock Text="MORE TOOLS" Foreground="#888888" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <WrapPanel x:Name="MoreButtons"/>
                </StackPanel>

                <!-- == Music: big controls for what's playing == -->
                <StackPanel x:Name="MusicPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="MusicArt" Width="112" Height="112" CornerRadius="14" Background="#1F1F1F">
                            <TextBlock x:Name="MusicArtPlaceholder" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="38" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                            <Button x:Name="MusicSourceButton" Style="{StaticResource ChipButton}" HorizontalAlignment="Left"
                                    Margin="0,0,0,8" Click="MusicSource_Click" ToolTip="Switch between apps playing media">
                                <TextBlock x:Name="MusicSourceText" Text="No app" FontSize="10" Foreground="#BBBBBB"/>
                            </Button>
                            <TextBlock x:Name="MusicTitle" Text="Nothing playing" Foreground="White" FontSize="17"
                                       FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MusicArtist" Foreground="#B0B0B0" FontSize="13" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="MusicAlbum" Foreground="#777777" FontSize="12" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                    <DockPanel Margin="0,12,0,0" LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}" Content="&#xE8B1;" FontSize="14"
                                    ToolTip="Shuffle" Click="Shuffle_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous" Click="Prev_Click"/>
                            <Button x:Name="MusicPlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                    FontSize="24" Width="46" Height="46" Margin="4,0" ToolTip="Play / Pause" Click="PlayPause_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next" Click="Next_Click"/>
                            <Button x:Name="RepeatButton" Style="{StaticResource IconButton}" Content="&#xE8EE;" FontSize="14"
                                    ToolTip="Repeat" Click="Repeat_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="MusicVolumeIcon" Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider x:Name="MusicVolume" Width="96" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                    Focusable="False" IsMoveToPointEnabled="True" ValueChanged="MusicVolume_ValueChanged"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <!-- == Volume for each app == -->
                <StackPanel x:Name="MixerPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <TextBlock Text="VOLUME FOR EACH APP" Foreground="#888888" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <TextBlock x:Name="MixerEmpty" Text="Nothing is making sound right now" Foreground="#777777"
                               FontSize="12" Margin="2,4,0,6" Visibility="Collapsed"/>
                    <StackPanel x:Name="MixerRows"/>
                </StackPanel>

                <!-- == Command bar: search apps, files, scripts == -->
                <StackPanel x:Name="SearchPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid>
                        <TextBox x:Name="SearchBox" Height="34" FontSize="15"
                                 Background="#161616" Foreground="White" CaretBrush="White" BorderBrush="#33FFFFFF"
                                 Padding="30,4,8,4" VerticalContentAlignment="Center"
                                 PreviewMouseDown="TextEntry_PreviewMouseDown" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel x:Name="SearchResults" Margin="0,6,0,0"/>
                    <TextBlock x:Name="SearchHint" Foreground="#666666" FontSize="10" Margin="2,6,0,0"
                               Text="Apps, your folders and scripts · ↑↓ to choose · Enter to open · Esc to close"/>
                </StackPanel>

                <!-- == Claude buttons (always available from the top bar) == -->
                <StackPanel x:Name="ClaudePanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <TextBlock Text="CLAUDE · Explain, Summarise and Fix use the text you last copied"
                               Foreground="#888888" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ClaudeEmpty" Visibility="Collapsed" Foreground="#777777" FontSize="12"
                               Margin="2,4,0,6" TextWrapping="Wrap"
                               Text="No Claude buttons found. Add an app named &quot;Claude&quot; in Edit quick actions."/>
                    <ItemsControl x:Name="ClaudeItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActionButton}" Click="Action_Click"
                                        ToolTip="{Binding Tooltip}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                        <TextBlock Text="{Binding Label}" FontSize="10" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid x:Name="ClipboardPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                        <TextBlock Text="CLIPBOARD · click to copy again" Foreground="#888888" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        <Button Style="{StaticResource ChipButton}" Content="Clear" DockPanel.Dock="Right"
                                Click="ClipboardClear_Click"/>
                    </DockPanel>
                    <TextBlock x:Name="ClipboardEmpty" Grid.Row="1" Text="Copy some text and it'll appear here"
                               Foreground="#777777" FontSize="12" Margin="2,6,0,8"/>
                    <ScrollViewer Grid.Row="1" MaxHeight="170" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl x:Name="ClipboardItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ClipItemButton}" Click="ClipboardItem_Click"
                                            ToolTip="{Binding Tooltip}">
                                        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- == Now playing == -->
                <Grid x:Name="MediaRow" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="ArtBorder" Width="84" Height="84" CornerRadius="12" Cursor="Hand"
                            Background="#1F1F1F" VerticalAlignment="Bottom" ToolTip="Open music controls"
                            MouseLeftButtonUp="ArtBorder_MouseLeftButtonUp">
                        <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                                   Foreground="#666666"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White"
                                   FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ArtistText" Text="" Foreground="#A0A0A0"
                                   FontSize="13" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Content="&#xE892;"
                                    ToolTip="Previous" Click="Prev_Click"/>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}"
                                    Content="&#xE768;" FontSize="20" Margin="6,0"
                                    ToolTip="Play / Pause" Click="PlayPause_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE893;"
                                    ToolTip="Next" Click="Next_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- == Song progress: elapsed | timeline (click or drag to seek) | remaining == -->
                <Grid x:Name="ProgressRow" Grid.Row="2" Margin="0,10,0,0" Height="16" Opacity="0.35">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="46"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#A0A0A0" FontSize="11"
                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    <Grid x:Name="ProgressTrack" Grid.Column="1" Background="Transparent" Margin="2,0,6,0"
                          MouseLeftButtonDown="ProgressTrack_MouseDown"
                          MouseMove="ProgressTrack_MouseMove"
                          MouseLeftButtonUp="ProgressTrack_MouseUp"
                          LostMouseCapture="ProgressTrack_LostMouseCapture"
                          MouseEnter="ProgressTrack_MouseEnter"
                          MouseLeave="ProgressTrack_MouseLeave">
                        <Border Height="4" CornerRadius="2" Background="#33FFFFFF" VerticalAlignment="Center"/>
                        <Border x:Name="TrackFill" Height="4" Width="0" CornerRadius="2" Background="White"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Ellipse x:Name="TrackThumb" Width="10" Height="10" Fill="White" Opacity="0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="RemainingText" Grid.Column="2" Text="-0:00" Foreground="#A0A0A0"
                               FontSize="11" Typography.NumeralAlignment="Tabular"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- == Quick actions for the app you're using (actions.json) == -->
                <StackPanel x:Name="ActionsPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="ActionsAppName" Foreground="#888888" FontSize="10" FontWeight="SemiBold"
                               Margin="2,0,0,6"/>
                    <ItemsControl x:Name="ActionItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ActionButton}" Click="Action_Click"
                                        ToolTip="{Binding Tooltip}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                        <TextBlock Text="{Binding Label}" FontSize="10" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- == Shelf: drop files here, drag them back out == -->
                <Border x:Name="ShelfArea" Grid.Row="4" Margin="0,12,0,0" Height="84"
                        CornerRadius="12" Background="#161616"
                        BorderBrush="#33FFFFFF" BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="ShelfHint" Text="Drop files here to keep them on the shelf"
                                   Foreground="#888888" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <ScrollViewer x:Name="ShelfScroller" Margin="0,0,36,0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      PreviewMouseWheel="ShelfScroller_PreviewMouseWheel">
                            <ItemsControl x:Name="ShelfItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="66" Margin="6,6,0,6" CornerRadius="8" Cursor="Hand"
                                                ToolTip="{Binding FullPath}"
                                                PreviewMouseLeftButtonDown="ShelfItem_MouseDown"
                                                PreviewMouseMove="ShelfItem_MouseMove"
                                                ContextMenuOpening="ShelfItem_ContextMenuOpening">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Open" Click="ShelfOpen_Click"/>
                                                    <MenuItem Header="Show in folder" Click="ShelfShowInFolder_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="Remove from shelf" Click="ShelfRemove_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <StackPanel VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="36" Height="36"
                                                       Stretch="Uniform" Margin="0,2,0,4"/>
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                           MaxWidth="60" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button x:Name="ClearShelfButton" Style="{StaticResource IconButton}"
                                Content="&#xE74D;" FontSize="13" Width="30" Height="30"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                ToolTip="Clear shelf" Click="ClearShelf_Click" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <!-- == Shown when there's nothing else to display == -->
                <!-- == System stats == -->
                <StackPanel x:Name="StatsRow" Grid.Row="6" Orientation="Horizontal" Margin="2,10,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="CpuStat" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="CpuText" Foreground="#DDDDDD" FontSize="12" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <StackPanel x:Name="RamStat" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="&#xEEA0;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="RamText" Foreground="#DDDDDD" FontSize="12" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <StackPanel x:Name="NetStat" Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                                   Foreground="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="NetText" Foreground="#DDDDDD" FontSize="12" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>

    <!-- == Bubbles that pop out around the open notch (Settings → Bubbles) == -->
    <Canvas x:Name="BubbleLayer"/>

    <!-- == Controller focus ring (ROG Ally mode) == -->
    <Canvas x:Name="NavLayer" IsHitTestVisible="False">
        <Border x:Name="NavRing" BorderBrush="#FF9F0A" BorderThickness="2" CornerRadius="9"
                Visibility="Collapsed"/>
    </Canvas>
    </Grid>
</Window>
