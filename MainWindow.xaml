<Window x:Class="WinNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinNotch"
        Width="900" Height="960"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="Secondary" Color="#8E8E93"/>
        <SolidColorBrush x:Key="Accent" Color="#FF9F0A"/>

        <!-- Rows in the search results -->
        <Style x:Key="ResultRow" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- System info tiles -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="11,9"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <!-- Round shortcut bubbles around the open notch -->
        <Style x:Key="BubbleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="21"
                                BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#262626"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#66FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Buttons on a due reminder (Done / Snooze) -->
        <Style x:Key="AlertButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round quick toggles on the home page (mic, do not disturb...) -->
        <Style x:Key="QuickToggle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-click menus that match the notch: dark, rounded, with icons -->
        <Style x:Key="NotchMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1C1C1E" BorderBrush="#3A3A3C" BorderThickness="1" CornerRadius="10"
                                Padding="5" Margin="0,0,8,8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="Black"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="10,6,18,6" MinWidth="170">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Width="18"
                                           Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#3A3A3C" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim volume sliders: thin track, filled in the accent colour, round white handle -->
        <Style x:Key="SlimRepeat" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlimRepeat}" Background="{DynamicResource Accent}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SlimRepeat}" Background="#3A3A3C"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="13" Height="13" Fill="White"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- Bubbles pop out around the open notch (Settings → Bubbles) -->
        <Canvas x:Name="BubbleLayer"/>
        <Border x:Name="Pill" Width="280" Height="32" Background="Black"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                CornerRadius="0,0,14,14" ClipToBounds="True"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                PreviewMouseWheel="Pill_PreviewMouseWheel"
                AllowDrop="True" DragEnter="Pill_DragEnter" DragOver="Pill_DragOver"
                DragLeave="Pill_DragLeave" Drop="Pill_Drop">
            <Grid>
                <!-- ===== Top line: date on the left, time on the right (always there) ===== -->
                <Grid x:Name="HeaderRow" Height="32" VerticalAlignment="Top" Margin="18,0,18,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <!-- Shows with "in 12 min" when a reminder is coming up -->
                        <TextBlock x:Name="ReminderBell" Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11.5" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                   Margin="0,1,6,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="DateText" Text="09/10/2026" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                    <TextBlock x:Name="TimeText" Text="21:33" Foreground="White" FontSize="12.5" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                </Grid>

                <!-- ===== Open notch ===== -->
                <StackPanel x:Name="Body" Margin="18,40,18,18" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">

                    <!-- A reminder that's due: stays until Done or Snooze -->
                    <Border x:Name="ReminderAlert" Visibility="Collapsed" Background="{DynamicResource Surface}" CornerRadius="14"
                            Padding="14,12,12,12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="{DynamicResource Accent}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock x:Name="ReminderAlertBell" Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                           Margin="0,0,14,0" RenderTransformOrigin="0.5,0.1">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform x:Name="ReminderBellSwing"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="ReminderAlertText" Text="Reminder" Foreground="White" FontSize="15"
                                               FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ReminderAlertWhen" Foreground="{StaticResource Secondary}" FontSize="11"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel x:Name="ReminderButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Search -->
                    <Border Background="{DynamicResource Surface}" CornerRadius="12" Height="40">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="14,0,0,0"
                                       IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search files, the web, or ask Claude"
                                       Foreground="{StaticResource Secondary}" FontSize="14" VerticalAlignment="Center"
                                       Margin="40,0,0,0" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White"
                                     CaretBrush="{DynamicResource Accent}" FontSize="14" VerticalContentAlignment="Center" Padding="36,0,12,0"
                                     PreviewMouseDown="SearchBox_PreviewMouseDown" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Pages under the search box: picked with the round page bubbles under the notch -->
                    <Grid x:Name="Pages">
                        <StackPanel x:Name="HomePage">
                            <!-- Quote of the day (hidden while you're searching) -->
                            <StackPanel x:Name="QuoteArea" Margin="6,10,6,0">
                                <TextBlock x:Name="QuoteText" Foreground="#C7C7CC" FontSize="12.5" FontStyle="Italic"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock x:Name="QuoteAuthor" Foreground="{StaticResource Secondary}" FontSize="10.5"
                                           TextAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="ResultsPanel" Margin="0,6,0,0" Visibility="Collapsed">
                                <StackPanel x:Name="Results"/>
                                <TextBlock x:Name="ResultsHint" Foreground="#636366" FontSize="10.5" Margin="10,6,0,0"
                                           Text="Enter opens · Shift+Enter searches the web · Ctrl+Enter asks Claude · Esc closes"/>
                            </StackPanel>

                            <!-- Home extras: weather + calendar, day progress, quick toggles (hidden while searching) -->
                            <StackPanel x:Name="GlanceArea">
                                <Grid x:Name="GlanceRow" Margin="-4,6,-4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="WeatherTile" Style="{StaticResource Tile}" Cursor="Hand" MouseLeftButtonUp="WeatherTile_Click">
                                        <DockPanel>
                                            <TextBlock x:Name="WeatherIcon" Text="&#x26C5;" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="White"
                                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="WeatherMain" Text="Weather" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="WeatherSub" Foreground="{StaticResource Secondary}" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border x:Name="CalendarTile" Grid.Column="1" Style="{StaticResource Tile}" Cursor="Hand" MouseLeftButtonUp="CalendarTile_Click">
                                        <DockPanel>
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="CalendarMain" Text="Calendar" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="CalendarSub" Foreground="{StaticResource Secondary}" FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>

                                <Border x:Name="DayProgressArea" Background="{DynamicResource Surface}" CornerRadius="12" Padding="12,8,12,10" Margin="0,6,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="DayProgressRight" DockPanel.Dock="Right" Foreground="{StaticResource Secondary}" FontSize="10.5"
                                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock x:Name="DayProgressLeft" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Grid Height="4" Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="DayDoneCol" Width="0*"/>
                                                <ColumnDefinition x:Name="DayLeftCol" Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" Background="#3A3A3C" CornerRadius="2"/>
                                            <Border Background="{DynamicResource Accent}" CornerRadius="2"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <WrapPanel x:Name="QuickToggleRow" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- Next reminder / running timer, counting down -->
                            <Border x:Name="NextReminder" Visibility="Collapsed" Background="{DynamicResource Surface}"
                                    CornerRadius="12" Padding="12,8,8,8" Margin="0,10,0,0">
                                <DockPanel>
                                    <Button x:Name="NextReminderCancel" DockPanel.Dock="Right" Style="{StaticResource AlertButton}"
                                            Padding="9,6" Margin="10,0,0,0" VerticalAlignment="Center" Click="NextReminderCancel_Click"
                                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Content="&#xE711;"/>
                                    <TextBlock x:Name="NextReminderCountdown" DockPanel.Dock="Right" FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" Margin="10,0,0,0"/>
                                    <TextBlock x:Name="NextReminderIcon" Text="&#xEA8F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="NextReminderText" Foreground="White" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="NextReminderWhen" Foreground="{StaticResource Secondary}" FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- System info: tiles, or one line -->
                            <UniformGrid x:Name="StatsGrid" Columns="4" Margin="-4,10,-4,0"/>
                        </StackPanel>

                        <StackPanel x:Name="MixerPage" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="VOLUME" Foreground="{StaticResource Secondary}" FontSize="10.5" FontWeight="SemiBold"
                                       Margin="4,0,0,6"/>
                            <StackPanel x:Name="MixerRows"/>
                            <TextBlock x:Name="MixerEmpty" Text="No other apps are playing sound right now"
                                       Foreground="{StaticResource Secondary}" FontSize="12" Margin="4,6,0,2" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Music: what's playing, with controls (and extras for some services) -->
                        <StackPanel x:Name="MusicPage" Visibility="Collapsed" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="MusicArt" Width="104" Height="104" CornerRadius="14" Background="{DynamicResource Surface}">
                                    <TextBlock x:Name="MusicArtIcon" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="34" Foreground="{StaticResource Secondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                                    <Border x:Name="MusicSource" Background="{DynamicResource Surface}" CornerRadius="10"
                                            Padding="9,3" HorizontalAlignment="Left" Margin="0,0,0,8" Cursor="Hand"
                                            MouseLeftButtonUp="MusicSource_MouseLeftButtonUp" ToolTip="Switch between apps playing">
                                        <TextBlock x:Name="MusicSourceText" Text="Nothing playing" FontSize="10.5"
                                                   Foreground="{StaticResource Secondary}"/>
                                    </Border>
                                    <TextBlock x:Name="MusicTitle" Text="Nothing playing" Foreground="White" FontSize="17"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MusicArtist" Foreground="#B0B0B5" FontSize="13" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="MusicAlbum" Foreground="{StaticResource Secondary}" FontSize="12"
                                               Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>

                            <!-- Progress: click or drag to jump -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="MusicElapsed" Text="0:00" FontSize="11" Foreground="{StaticResource Secondary}"
                                           VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                <Slider x:Name="MusicProgress" Grid.Column="1" Style="{StaticResource SlimSlider}" Maximum="1000"
                                        Margin="4,0" ValueChanged="MusicProgress_ValueChanged"
                                        PreviewMouseLeftButtonDown="MusicProgress_PreviewMouseLeftButtonDown"
                                        PreviewMouseLeftButtonUp="MusicProgress_PreviewMouseLeftButtonUp"/>
                                <TextBlock x:Name="MusicRemaining" Grid.Column="2" Text="-0:00" FontSize="11" TextAlignment="Right"
                                           Foreground="{StaticResource Secondary}" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular"/>
                            </Grid>

                            <!-- Controls -->
                            <StackPanel x:Name="MusicControls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"/>

                            <!-- Extras for the music service (e.g. Spotify's Like and Smart Shuffle) -->
                            <WrapPanel x:Name="MusicExtrasPanel" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>

                        <!-- Shelf: drop files here to keep them handy, drag them out again -->
                        <StackPanel x:Name="ShelfPage" Visibility="Collapsed" Margin="0,12,0,0">
                            <DockPanel Margin="4,0,2,6">
                                <TextBlock x:Name="ShelfClear" DockPanel.Dock="Right" Text="Clear all" FontSize="10.5"
                                           Foreground="{StaticResource Secondary}" Cursor="Hand" Visibility="Collapsed"
                                           MouseLeftButtonUp="ShelfClear_MouseLeftButtonUp"/>
                                <TextBlock x:Name="ShelfTitle" Text="SHELF" Foreground="{StaticResource Secondary}"
                                           FontSize="10.5" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Border x:Name="ShelfDrop" CornerRadius="12" BorderThickness="1" BorderBrush="#33FFFFFF"
                                    Background="{DynamicResource Surface}" MinHeight="100">
                                <Grid>
                                    <StackPanel x:Name="ShelfEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="{StaticResource Secondary}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drop files here to keep them handy, then drag them out to wherever you need them"
                                                   Foreground="{StaticResource Secondary}" FontSize="11.5" Margin="0,6,0,0"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
                                    </StackPanel>
                                    <WrapPanel x:Name="ShelfItems" Margin="6"/>
                                </Grid>
                            </Border>

                            <!-- Scratch pad: quick notes, saved as you type -->
                            <StackPanel x:Name="ScratchArea" Margin="0,10,0,0">
                                <DockPanel Margin="4,0,2,6">
                                    <TextBlock x:Name="ScratchSaved" DockPanel.Dock="Right" FontSize="10.5"
                                               Foreground="{StaticResource Secondary}"/>
                                    <TextBlock Text="SCRATCH PAD" Foreground="{StaticResource Secondary}" FontSize="10.5" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="4">
                                    <Grid>
                                        <TextBlock x:Name="ScratchPlaceholder" Text="Jot something down - it's saved as you type"
                                                   Foreground="{StaticResource Secondary}" FontSize="12.5" Margin="8,6,0,0"
                                                   IsHitTestVisible="False"/>
                                        <TextBox x:Name="ScratchBox" Background="Transparent" BorderThickness="0" Foreground="White"
                                                 CaretBrush="{DynamicResource Accent}" FontSize="12.5" Padding="4,4"
                                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                                 Height="110" VerticalScrollBarVisibility="Auto"
                                                 PreviewMouseDown="ScratchBox_PreviewMouseDown" TextChanged="ScratchBox_TextChanged"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Tidy up: clear temp folders and the Recycle Bin, run your own scripts -->
                        <StackPanel x:Name="TidyPage" Visibility="Collapsed" Margin="0,12,0,0">
                            <DockPanel Margin="4,0,2,6">
                                <TextBlock x:Name="TidyRescan" DockPanel.Dock="Right" Text="Check again" FontSize="10.5"
                                           Foreground="{StaticResource Secondary}" Cursor="Hand" MouseLeftButtonUp="TidyRescan_Click"/>
                                <TextBlock Text="CLEAN UP" Foreground="{StaticResource Secondary}" FontSize="10.5" FontWeight="SemiBold"/>
                            </DockPanel>
                            <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="4,4,4,8">
                                <StackPanel>
                                    <StackPanel x:Name="CleanRows"/>
                                    <TextBlock x:Name="CleanEmpty" Text="Nothing to clean - add folders in Settings → Tidy up" Visibility="Collapsed"
                                               Foreground="{StaticResource Secondary}" FontSize="11.5" Margin="10,8" TextWrapping="Wrap"/>
                                    <DockPanel Margin="10,8,6,0">
                                        <Button x:Name="CleanAllButton" DockPanel.Dock="Right" Style="{StaticResource AlertButton}"
                                                Content="Clean all" Click="CleanAll_Click" Background="{DynamicResource Accent}" Foreground="Black"/>
                                        <TextBlock x:Name="CleanSummary" Foreground="{StaticResource Secondary}" FontSize="11.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="ScriptArea" Margin="0,12,0,0">
                                <TextBlock Text="SCRIPTS" Foreground="{StaticResource Secondary}" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,2,6"/>
                                <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="4">
                                    <StackPanel>
                                        <StackPanel x:Name="ScriptRows"/>
                                        <TextBlock x:Name="ScriptEmpty" Foreground="{StaticResource Secondary}" FontSize="11.5" Margin="10,8"
                                                   TextWrapping="Wrap" Text="Add your own .bat, .cmd or .ps1 files in Settings → Tidy up to run them from here with one click."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Which page you're on -->
                    <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                ToolTip="Scroll to switch pages"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
